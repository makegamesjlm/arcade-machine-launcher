#!/bin/sh

# Keep the launcher build number in the commit that advances master.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "master" ] || exit 0

repo_root=$(git rev-parse --show-toplevel) || exit 1
build_file="$repo_root/BUILD_NUMBER"

if [ ! -f "$build_file" ]; then
	echo "pre-commit: BUILD_NUMBER is missing" >&2
	exit 1
fi

build_number=$(tr -d '[:space:]' < "$build_file")
case "$build_number" in
	''|*[!0-9]*)
		echo "pre-commit: BUILD_NUMBER must contain a non-negative integer" >&2
		exit 1
		;;
esac

build_number=$((build_number + 1))
printf '%s\n' "$build_number" > "$build_file"
git add -- "$build_file"
echo "Build number: $build_number"
